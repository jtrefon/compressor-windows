<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CompressorWindows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Compressor for Windows">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="8" Margin="24" MaxWidth="720" HorizontalAlignment="Left"
                    AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">

            <TextBlock Text="Compress / Decompress" FontWeight="SemiBold" />
            <TextBox x:Name="InputPath" Header="Input file" />
            <TextBox x:Name="OutputPath" Header="Output file" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="BrowseInBtn" Content="Browse input..." Click="OnBrowseInClick" />
                <Button x:Name="BrowseOutBtn" Content="Browse output..." Click="OnBrowseOutClick" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="16">
                <ComboBox x:Name="StrategyCombo" Header="Strategy" Width="220" />
                <ComboBox x:Name="ThreadsCombo" Header="Threads" Width="140" />
            </StackPanel>
            <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" />
            <TextBlock x:Name="LiveStatusText" TextWrapping="Wrap" Opacity="0.8" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="CompressBtn" Content="Compress" Click="OnCompressClick" />
                <Button x:Name="DecompressBtn" Content="Decompress" Click="OnDecompressClick" />
                <Button x:Name="CancelBtn" Content="Cancel" Click="OnCancelClick" IsEnabled="False" />
            </StackPanel>
            <TextBlock Text="Tip: drag files onto this window, or double-click a .cpz file in Explorer." Opacity="0.5" />

            <TextBlock Text="Archive (.cza)" FontWeight="SemiBold" Margin="0,16,0,0" />
            <TextBox x:Name="ArchivePath" Header="Archive file" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="BrowseArchiveBtn" Content="Browse..." Click="OnBrowseArchiveClick" />
                <Button x:Name="CreateArchiveBtn" Content="Create from files..." Click="OnCreateArchiveClick" />
                <Button x:Name="OpenArchiveBtn" Content="Open &amp; verify" Click="OnOpenArchiveClick" />
                <Button x:Name="ExtractArchiveBtn" Content="Extract selected..." Click="OnExtractArchiveClick" />
            </StackPanel>
            <ListView x:Name="ArchiveEntries" Height="160" SelectionMode="Single" />
            <TextBlock x:Name="ArchiveStatusText" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
                <Button x:Name="CheckUpdatesBtn" Content="Check for updates..." Click="OnCheckUpdatesClick" />
                <TextBlock x:Name="VersionText" VerticalAlignment="Center" Opacity="0.6" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>